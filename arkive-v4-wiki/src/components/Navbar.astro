---
import { Image } from "astro:assets";
const routes = [
  "characters",
  "blueprints",
  "documents",
  "maps",
  "connections",
  "calendars",
  "dictionaries",
  "gallery",
];
---

<nav
  class="mx-auto flex min-h-8 w-full max-w-3xl flex-col items-start gap-y-2 px-4 text-white xl:max-w-4xl"
>
  <h2 class="flex flex-nowrap items-center text-2xl font-bold">
    <Image
      src={"/Logo.webp"}
      width={64}
      height={64}
      alt="ArkiveLogo"
      class="relative -left-1"
    />

    The Arkive Wiki
  </h2>
  <ul class="flex flex-nowrap gap-x-2">
    {
      routes.map((route) => (
        <li>
          <a
            id={`nav_${route}`}
            class="transition-all hover:text-blue-300 active:text-blue-600"
            href={`/${route}`}
          >{`${route.charAt(0).toUpperCase()}${route.slice(1)}`}</a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  if (window.location.pathname.includes("characters")) {
    const navItem = document
      .getElementById("nav_characters")
      ?.classList?.toggle("text-blue-400");
  }
</script>
