---
import { Image } from "astro:assets";
import type { Size } from "../types/baseTypes";
const { src, size = "md" } = Astro.props;

function getAvatarSize(size: Size): { classes: string; sizes: number } {
  if (size === "lg") return { classes: "w-10 h-10", sizes: 40 };
  if (size === "4xl") return { classes: "w-20 h-20", sizes: 80 };
  return { classes: "w-[30px] h-[30px]", sizes: 30 };
}
const avatarSizes = getAvatarSize(size);
---

<div
  class={`${avatarSizes.classes} overflow-hidden rounded-full object-contain`}
>
  <Image
    width={avatarSizes.sizes}
    height={avatarSizes.sizes}
    alt="avatar"
    {src}
  />
</div>
