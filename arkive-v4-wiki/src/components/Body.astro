---
import Navbar from "./Navbar.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>The Arkive Wiki</title>
  </head>
  <body
    class="min-w-screen flex h-screen max-h-screen min-h-screen flex-col bg-black"
  >
    <Navbar />
    <div class="mx-auto w-full max-w-3xl h-[calc(100vh-5rem)] flex-1 p-4 text-white xl:max-w-4xl">
      <slot />
    </div>
  </body>
</html>
