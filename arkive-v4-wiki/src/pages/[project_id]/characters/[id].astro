---
import Avatar from "../../../components/Avatar.astro";
import Body from "../../../components/Body.astro";
import Content from "../../../components/Content.astro";
import type { CharacterType } from "../../../types/entityTypes";
import { getImageURL } from "../../../utils/imageUtils";

const { project_id, id } = Astro.params;

const res = await fetch(
  `${import.meta.env.PUBLIC_SERVER}/${project_id}/characters/${id}`,
);

const data = (await res.json()) as CharacterType;
---

<Body>
  <Content>
    <h1 class="flex items-center gap-x-8">
     {data?.image_id ? <Avatar
        src={getImageURL(project_id as string, "images", data.image_id)}
        size="4xl"
      /> :null}
      <span class="text-4xl font-bold">
        {data.title}
      </span>
    </h1>
    <div class="flex h-full flex-1 flex-col gap-y-2 overflow-auto px-2"></div>
  </Content>
</Body>
