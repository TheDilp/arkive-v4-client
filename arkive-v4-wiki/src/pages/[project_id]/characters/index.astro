---
import Avatar from "../../../components/Avatar.astro";
import Body from "../../../components/Body.astro";
import Content from "../../../components/Content.astro";
import { getImageURL } from "../../../utils/imageUtils";
import type { CharacterType } from "../../../types/entityTypes";

const { project_id } = Astro.params;

const res = await fetch(
  `${import.meta.env.PUBLIC_SERVER}/${project_id}/characters`,
);

const data = (await res.json()) as CharacterType[];
---

<Body>
  <Content>
    <ul
      class="flex w-full flex-col max-h-full overflow-auto rounded border border-x border-zinc-800 bg-zinc-950"
    >
      {
        data.map((char) => (
          <li class="flex h-12 max-h-12 items-center border-b border-zinc-800 p-2 last:border-b-0 hover:bg-zinc-700">
            <a
              href={`characters/${char.id}`}
              class="flex flex-1 cursor-pointer flex-nowrap items-center gap-x-2 transition-colors hover:text-blue-400 active:text-blue-600"
            >
              {char.image_id ? (
                <Avatar
                  src={getImageURL(
                    project_id as string,
                    "images",
                    char.image_id,
                  )}
                />
              ) : null}
              <span>{char.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Content>
</Body>
